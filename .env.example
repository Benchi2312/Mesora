# Copia este archivo a `.env.local` y completa los valores
# (o define estas variables en el panel de Vercel para el deploy)

# URL del proyecto en Supabase (Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon (Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# El backend simulado solo se activa si lo habilitas manualmente en desarrollo.
# Para el piloto, deja esta opción en false y configura las variables de Supabase.
VITE_MESORA_MODO_LOCAL=false
